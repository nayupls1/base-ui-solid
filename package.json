{
  "name": "base-ui-solid-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "docs"
  ],
  "scripts": {
    "dev": "bun run --cwd docs dev",
    "build:docs": "bun run --cwd docs build",
    "test": "vitest run",
    "typecheck": "tsc -p packages/solid/tsconfig.json --noEmit && tsc -p packages/utils/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@solidjs/testing-library": "1.0.0-rc.2",
    "@solidjs/vite-plugin": "3.0.0-next.57",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "jsdom": "^27.0.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0",
    "playwright-core": "^1.56.1"
  }
}
